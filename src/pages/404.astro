---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui } from '../i18n/ui';

// GitHub Pages は任意のパスの 404 に対してこの 1 ページを返すため、
// 訪問者の言語が分からない。日英を併記する。
const langs = ['ja', 'en'] as const;
---

<BaseLayout title={`404 — ${ui.ja['notFound.title']}`} description={ui.en['notFound.body']}>
  <section class="section">
    <div class="container not-found">
      <p class="code">404</p>
      {langs.map((lang) => (
        <div class="block" lang={lang}>
          <h1>{ui[lang]['notFound.title']}</h1>
          <p class="body">{ui[lang]['notFound.body']}</p>
          <a href={lang === 'ja' ? '/' : '/en/'}>{ui[lang]['notFound.home']}</a>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    max-width: 40rem;
  }

  .code {
    font-family: var(--font-mono);
    font-size: clamp(3rem, 12vw, 5rem);
    font-weight: 600;
    line-height: 1;
    color: var(--accent);
  }

  .block h1 {
    font-size: clamp(1.4rem, 3.5vw, 1.9rem);
    margin-bottom: 0.5rem;
  }

  .body {
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }
</style>
