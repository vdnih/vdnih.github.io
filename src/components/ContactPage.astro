---
import LegalLayout from '../layouts/LegalLayout.astro';
import ContactBlock from './ContactBlock.astro';
import { appPath, apps, profile } from '../lib/apps';
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// アプリ固有の問い合わせは、各アプリのサポートページに寄せたほうが
// 端末やバージョンの情報が揃いやすい。
const appSupport = apps.map((app) => ({
  label: app.name,
  href: appPath(app.id, 'support', lang),
}));
---

<LegalLayout
  title={t('contact.title')}
  description={t('contact.lead')}
  crumbs={[{ label: t('nav.home'), href: localizePath('/', lang) }, { label: t('contact.title') }]}
>
  <p>{t('contact.lead')}</p>

  <ContactBlock heading={t('support.emailLabel')} lead={t('support.responseNote')} />

  {appSupport.length > 0 && (
    <section class="contact-section">
      <h2>{t('legal.support')}</h2>
      <ul class="links">
        {appSupport.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </section>
  )}

  <section class="contact-section">
    <h2>{t('about.contact')}</h2>
    <ul class="links">
      {profile.links.map((link) => (
        <li>
          <a href={link.url} rel="me noopener" target="_blank">{link.label}</a>
        </li>
      ))}
    </ul>
  </section>
</LegalLayout>

<style>
  .contact-section {
    margin-block-start: 2.75rem;
  }

  .contact-section h2 {
    font-size: 1.05rem;
    margin-block-end: 0.9rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-size: 0.92rem;
  }
</style>
