---
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();

// ストア審査担当とユーザーの双方が、どのページからでも
// ポリシーと問い合わせ先へ辿れるようにする。
const links = [
  { href: localizePath('/apps/', lang), label: t('nav.apps') },
  { href: localizePath('/contact/', lang), label: t('footer.contact') },
  { href: localizePath('/privacy/', lang), label: t('sitePrivacy.title') },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <nav class="footer-nav" aria-label={t('footer.legal')}>
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer-meta">
      <p>© {year} vdnih</p>
      <p class="built-with">
        {t('footer.builtWith')}
        {' '}
        <a href="https://github.com/vdnih/vdnih.github.io" rel="noopener" target="_blank">
          {t('footer.source')}
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: 2.25rem;
    font-size: 0.83rem;
    color: var(--text-muted);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }

  .built-with {
    max-width: 40rem;
  }
</style>
