---
import { languages } from '../i18n/ui';
import { getAlternateLang, getAlternatePath, getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const alternateLang = getAlternateLang(lang);
const alternatePath = getAlternatePath(Astro.url, lang);
---

<a class="lang-switcher" href={alternatePath} hreflang={alternateLang} lang={alternateLang} aria-label={`${t('lang.label')}: ${languages[alternateLang]}`}>
  <svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8">
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18"></path>
  </svg>
  {languages[alternateLang]}
</a>

<style>
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .lang-switcher:hover {
    color: var(--text);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
</style>
